<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Replaces the old com.ivy.weeklyplanner label, which pointed at
         proactive_agents/weekly_planner.py — a file that has never existed
         in any committed branch, so this schedule never actually ran
         anything. Points at the real, working Familia_meal_planner.py.
         The scheduled flag preserves the 48-hour gate; the send flag
         actually delivers. (Both are spelled out rather than written as
         flags: a double hyphen is not legal inside an XML comment, and
         plistlib/launchctl reject the whole file over it.) -->
    <key>Label</key>
    <string>com.ivy.familia_meal_planner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PYTHON__</string>
        <string>-m</string>
        <string>proactive_agents.Familia_meal_planner</string>
        <string>--scheduled</string>
        <string>--send</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__PROJECT_ROOT__</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/familia_meal_planner.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/familia_meal_planner.log</string>
    <!--
      Daily as of 2026-09-09, at Henry's request. Omitting Weekday is what
      makes StartCalendarInterval fire every day: launchd matches only the
      keys present, so Hour+Minute alone means "every day at that time".
      Weekday 0 (Sunday) is what made it weekly.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
</dict>
</plist>
