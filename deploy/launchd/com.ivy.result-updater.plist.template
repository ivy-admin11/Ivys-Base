<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Grades saved picks against completed games every 6 hours.

  This unit carried an inline ODDS_API_KEY until 2026-09-09. A launchd plist in
  ~/Library/LaunchAgents is mode 644, so that was a live credential readable by
  every process on the machine, and because config.py loads .env with
  override=False it also silently beat the real key in .env. The key now comes
  from .env like every other agent's — never reintroduce it here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivy.result-updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PYTHON__</string>
        <string>-m</string>
        <string>ivy_core.result_updater</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/result-updater.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/result-updater.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
