# Google APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# DeepSeek (primary LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# xAI (Grok) — used by the 'brain' job
XAI_API_KEY=your_xai_api_key_here

# External Services
ODDS_API_KEY=your_odds_api_key_here
READWISE_API_KEY=your_readwise_api_key_here

# Contacts — REQUIRED. The process refuses to start without them; there is no
# default. Variable names are CASE-SENSITIVE: a ".env" line reading
# "Henry_PHONE" is silently ignored, because the code reads "HENRY_PHONE".
# That exact typo went unnoticed for months (the hardcoded fallback happened to
# be the same number, so editing .env appeared to change nothing).
HENRY_PHONE=+15555550100
LEXI_PHONE=+15555550101

# Google Sheets (Sharp Picks results tracking)
GOOGLE_SHEET_ID=your_sheet_id_here
SPORTS_DASHBOARD_SPREADSHEET_ID=your_spreadsheet_id_here

# OpenAI — fallback client when the xai_sdk import is unavailable
OPENAI_API_KEY=your_openai_api_key_here

# Security — required; the process refuses to start without this set.
# For local/test use only, set ALLOW_INSECURE_ADMIN_SECRET=true instead.
ADMIN_SECRET=your_shared_secret_here

# Feature flags
ENABLE_IMESSAGE_POLLER=true
ENABLE_CALENDAR_INTEGRATION=true
ENABLE_REMINDERS_INTEGRATION=true
ENABLE_READWISE_INTEGRATION=true
ENABLE_SPORTS_PICKS=true
ENABLE_GROCERY_STAGING=true

# Local Configuration
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
