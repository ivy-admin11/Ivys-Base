# Google APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# Google Sheets — Sharp Picks canonical snapshot sync
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_PICKS_TAB=Sharp Picks
GOOGLE_SHEETS_SUMMARY_TAB=Summary

# DeepSeek (primary LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI (first conversational fallback)
OPENAI_API_KEY=your_openai_api_key_here

# xAI (Grok) — used by the 'brain' job
XAI_API_KEY=your_xai_api_key_here

# External Services
ODDS_API_KEY=your_odds_api_key_here
READWISE_API_KEY=your_readwise_api_key_here

# Contacts
HENRY_PHONE=+10000000000
LEXI_PHONE=+10000000000

# Local contact allowlist (real allowlists are gitignored — see favorites.example.json)
IVY_FAVORITES_FILE=favorites.json

# Security — required; the process refuses to start without this set.
# For local/test use only, set ALLOW_INSECURE_ADMIN_SECRET=true instead.
ADMIN_SECRET=your_shared_secret_here

# Feature flags
ENABLE_IMESSAGE_POLLER=true
ENABLE_CALENDAR_INTEGRATION=true
ENABLE_REMINDERS_INTEGRATION=true
ENABLE_READWISE_INTEGRATION=true
ENABLE_SPORTS_PICKS=true
ENABLE_GROCERY_STAGING=true

# iMessage collection and processing limits
# Values outside the bounds enforced by config.py fail fast at startup.
POLLING_INTERVAL=1
IMESSAGE_FETCH_BATCH_SIZE=20
IMESSAGE_QUEUE_MAXSIZE=100
IMESSAGE_SLOW_QUEUE_MAXSIZE=50
IMESSAGE_DEBOUNCE_SECONDS=2.0
IMESSAGE_QUEUE_PUT_TIMEOUT_SECONDS=1.0
IMESSAGE_STALE_QUEUE_SECONDS=30
IMESSAGE_WORKER_JOIN_TIMEOUT_SECONDS=5
IMESSAGE_SLOW_ACK_SECONDS=5.0

# Local Apple integration and status-command timeouts (seconds)
IMESSAGE_SEND_TIMEOUT_SECONDS=10
APPLE_CALENDAR_TIMEOUT_SECONDS=8
APPLE_REMINDERS_TIMEOUT_SECONDS=8
STATUS_COMMAND_TIMEOUT_SECONDS=5

# Detached/scheduled job lifecycle (seconds)
IVY_JOB_HEARTBEAT_SECONDS=15
IVY_JOB_MAX_RUNTIME_SECONDS=3600

# Optional state-path overrides. Keep these on local, private storage.
# IVY_RECEIPTS_DB=/absolute/path/to/logs/executions.db
# IVY_IMESSAGE_STATE_DB=/absolute/path/to/logs/imessage_worker.db

# Local Configuration
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
